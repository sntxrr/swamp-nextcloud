# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# Local test models. This repo publishes an extension, not a deployment, and
# model instances created here to exercise it against a real Nextcloud carry
# internal hostnames, container names and SSH targets. Only manifest-declared
# files ship in the bundle, but this repo is public, so keep them out of git too.
/models/
vaults/

# Adversarial review reports are keyed by content hash and regenerated per
# release; they stay local.
.review/

# .swamp.yaml is operator state (datastore, repoId). Extension repos track only
# the .example -- the running implementation lives in the private homelab repo.
.swamp.yaml
